# Local application mode: demo is deterministic and requires no NewsAPI account.
NEWS_MODE=demo

# API and dashboard URLs.
NEWS_API_URL=http://localhost:8000/api/articles
NEWS_PROVIDER_URL=https://newsapi.org/v2/top-headlines
NEWS_API_KEY=

# Required for local JWT authentication. Replace both values in your own .env file.
AUTHJWT_SECRET_KEY=replace-with-a-long-random-development-secret
DEMO_USER=admin
DEMO_PASSWORD=replace-with-a-local-password

# SQLite is the default. For a deployed environment, provide a managed SQLAlchemy URL.
DATABASE_URL=sqlite:///./backend/news.db

# Required only for live Celery ingestion.
REDIS_URL=redis://localhost:6379/0

# Optional dashboard configuration.
STREAMLIT_SERVER_PORT=8501
